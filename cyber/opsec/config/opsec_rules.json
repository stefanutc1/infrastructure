{
  "version": "1.0.0",
  "policy_name": "Enterprise Autonomous OPSEC & Redaction Policy",
  "author": "stefanutc1",
  "classification": "TLP:CLEAR",
  "sanitization_rules": {
    "api_keys": [
      {
        "name": "Generic High-Entropy Key",
        "regex": "(?i)(api[_-]?key|secret[_-]?key|access[_-]?token)[\\s]*[:=][\\s]*['\"]?([A-Za-z0-9_\\-]{24,})['\"]?",
        "replacement": "[REDACTED_API_KEY]"
      },
      {
        "name": "GitHub Token",
        "regex": "gh[pousr]_[A-Za-z0-9_]{20,}",
        "replacement": "[REDACTED_GITHUB_TOKEN]"
      },
      {
        "name": "AWS Access Key",
        "regex": "(?:AKIA|ABIA|ACCA|ASIA)[0-9A-Z]{16}",
        "replacement": "[REDACTED_AWS_KEY]"
      },
      {
        "name": "Slack Token",
        "regex": "xox[baprs]-[0-9A-Za-z]{10,48}",
        "replacement": "[REDACTED_SLACK_TOKEN]"
      }
    ],
    "network_identifiers": [
      {
        "name": "RFC1918 Private IPv4",
        "regex": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
        "replacement": "[REDACTED_INTERNAL_IP]"
      },
      {
        "name": "Hardware MAC Address",
        "regex": "\\b(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}\\b",
        "replacement": "[REDACTED_MAC_ADDRESS]"
      }
    ],
    "pii": [
      {
        "name": "Email Address",
        "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
        "replacement": "[REDACTED_EMAIL]"
      },
      {
        "name": "Credit Card Number",
        "regex": "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|3(?:0[0-5]|[68][0-9])[0-9]{11}|6(?:011|5[0-9]{2})[0-9]{12})\\b",
        "replacement": "[REDACTED_CREDIT_CARD]"
      }
    ]
  },
  "prompt_injection_signatures": [
    "(?i)ignore\\s+all\\s+(prior|previous|above)\\s+instructions",
    "(?i)disregard\\s+all\\s+safety\\s+guidelines",
    "(?i)reveal\\s+your\\s+system\\s+prompt",
    "(?i)output\\s+your\\s+initial\\s+instructions\\s+verbatim",
    "(?i)you\\s+are\\s+now\\s+in\\s+developer\\s+mode",
    "(?i)bypass\\s+operational\\s+boundaries",
    "(?i)exfiltrate\\s+all\\s+stored\\s+memory"
  ],
  "canary_token_prefix": "CANARY-OPSEC-TK-"
}
