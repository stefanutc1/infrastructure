# ==========================================
# ELO ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Application Settings
ELO_ENV=development
ELO_HOST=0.0.0.0
ELO_PORT=8000
ELO_SECRET_KEY=change_this_to_a_random_32_char_secret_key_minimum

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_personal_telegram_chat_id

# Database & Cache
DATABASE_URL=postgresql://elo_admin:elo_secure_pass_change_me@localhost:5432/elo_brain
REDIS_URL=redis://localhost:6379/0

# LLM Providers Configuration
PRIMARY_LLM_PROVIDER=mock       # options: mock, local_ollama, cloud_gemini, cloud_claude
FALLBACK_LLM_PROVIDER=mock      # options: mock, local_ollama, cloud_gemini, cloud_claude

# Local LLM (Ollama / vLLM on Proxmox)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# Cloud LLM APIs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Approval Gatekeeper
DEFAULT_APPROVAL_TIMEOUT_SECONDS=300
ENABLE_STRICT_L3_CHALLENGE=true
