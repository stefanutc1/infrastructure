# PostgreSQL Settings
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=netbox_secure_pg_password
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox_secure_pg_password

# Redis Settings
REDIS_HOST=redis
REDIS_CACHE_HOST=redis-cache
REDIS_PASSWORD=netbox_secure_redis_password

# NetBox Application Settings
SECRET_KEY=generate_a_random_50_character_secret_key_here_for_netbox
ALLOWED_HOSTS=*
DB_WAIT_DEBUG=0
METRICS_ENABLED=true
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@infrastructure.lan
SUPERUSER_PASSWORD=admin_password_change_me
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
