# ==============================================================================
# CONFIGURAȚIE MEDIU MEDIA & *ARR STACK
# ==============================================================================

PUID=1000
PGID=1000
TZ=Europe/Bucharest
UMASK=002

# Rădăcina stocării pentru hardlinks atomice (ZFS pool sau NFS mount de pe OMV)
STORAGE_ROOT=/data

# Adresa publică sau LAN a serverului Jellyfin
JELLYFIN_PUBLIC_URL=http://192.168.1.132:8096

# Configurație VPN Gluetun (Killswitch pentru qBittorrent)
# Valori posibile pentru VPN_SERVICE_PROVIDER: custom, mullvad, protonvpn, nordvpn, ivpn, airvpn, surfshark, etc.
VPN_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key_here=
WIREGUARD_ADDRESSES=10.2.0.2/32
WIREGUARD_PRESHARED_KEY=your_preshared_key_here=
VPN_ENDPOINT_IP=185.156.172.5
VPN_ENDPOINT_PORT=51820
