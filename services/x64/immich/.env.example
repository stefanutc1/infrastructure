# ==============================================================================
# CONFIGURAȚIE MEDIU IMMICH
# ==============================================================================

# Versiunea de Immich
IMMICH_VERSION=release

# Calea pe disc pentru stocarea fotografiilor (pool ZFS sau NFS)
UPLOAD_LOCATION=/data/photos

# Calea pentru datele bazei PostgreSQL
DB_DATA_LOCATION=./config/postgres

# Date autentificare bază de date
DB_PASSWORD=immich_secure_db_password_change_me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Setări rețea & timezone
TZ=Europe/Bucharest
